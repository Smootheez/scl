{
	"schemaVersion": 1,
	"id": "${modid}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": ["Smootheez"],
	"contact": {
		"homepage": "https://github.com/Smootheez/scl",
		"sources": "https://github.com/Smootheez/scl",
		"issues": "https://github.com/Smootheez/scl/issues"
	},
	"license": "${mod_license}",
	"icon": "assets/scl/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
          "dev.smootheez.scl.SmootheezConfigLib"
		],
		"modmenu": [
			"dev.smootheez.scl.modmenu.ModMenuApiImpl"
		],
		"scl": [
			"dev.smootheez.scl.example.ExampleConfig"
		]
	},
	"accessWideners": [
		"scl.accesswideners"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": ">=${minecraft_version}"
	}
}